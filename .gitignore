# Visual Studio user specific files
.vsconfig
GantryExamples.code-workspace
.vs/

# Idea user specific files
.idea/
*.DotSettings.user

# Linux specific files
.ignore
.vscode/
Makefile

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Debug symbols
*.pdb

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*
Plugins/*/*/Binaries/*
Plugins/*/*/*/Binaries/*
Plugins/*/*/*/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*
Plugins/*/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

#Plugins
Plugins/Marketplace/
DocGen/

# Gantry ships from Fab into the engine; a development checkout of it (its own repo, UE-Gantry) may
# sit at Plugins/Gantry as a folder or a link, and is never part of this project.
/Plugins/Gantry
/Plugins/PVAS-DocGen

# Authoring and test tooling lives outside this repo (private); never commit it here.
/Tools/

# Release metadata from packaging with -createreleaseversion; mods cook against it locally.
/Releases/

# Mods are tracked as source. What cooking or compiling them produces is not.
/Mods/*/Content/Paks/
/Mods/*/Saved/
/Mods/*/Intermediate/
/Mods/*/Binaries/
